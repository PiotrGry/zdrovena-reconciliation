# PoC image for zdrovena#583 (E6/E7): the report download driver with Chromium.
# The Playwright base image tag must match the playwright version in uv.lock.
FROM mcr.microsoft.com/playwright/python:v1.65.1-noble
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/app/.venv UV_LINK_MODE=copy PYTHONPATH=/app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --extra report --no-install-project --no-dev
COPY zdrovena ./zdrovena
COPY scripts/poc ./scripts/poc
# The browsers come with the base image; point Playwright at them.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENTRYPOINT ["/app/.venv/bin/python", "-m", "scripts.poc.fakturownia_poc"]

# Secrets
.env
.env.local
.env.*.local
*.agekey
*.agekey.txt
# Staging files from the SOPS tier's atomic writes. Deliberately NOT
# ".env.local.sops" — that file IS committed (it is encrypted). These only
# linger if a write is interrupted mid-flight.
tmp*.env.local.sops
age*.key
keys.txt

# OS
.DS_Store
._*
__MACOSX/
Thumbs.db

# CSV output (generated)
csv/

# Logs
*.log

# Terraform
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/*.tfplan
infra/terraform/tfplan
infra/terraform/terraform.tfvars
# backend.hcl intentionally NOT gitignored — values are Azure resource names,
# not secrets. Backend security is RBAC + storage_use_azuread, not concealment.
infra/terraform/.terraform.lock.hcl

# Coverage
.coverage
coverage.json
htmlcov/
.claude/

# Docker local dev
.env.local.template.bak
.gstack/
.env.smoke
.venv-local

# git worktrees (superpowers subagent-driven-development)
.worktrees/
*.pdf
# …except reports we deliberately keep with the documentation.
!docs/reports/*.pdf
tmp/
outputs/
